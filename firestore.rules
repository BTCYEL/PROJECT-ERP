    match /purchase_orders/{poId} {
      allow get: if isValidId(poId) && isDocOwner();
      allow list: if isEmailVerified() && (resource.data.ownerUid == request.auth.uid || isBootstrapAdmin());
      allow create: if isEmailVerified() && isValidId(poId) && isValidPurchaseOrder(incoming())
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(poId) && isDocOwner() && isValidPurchaseOrder(incoming())
        && preservesImmutableOwnerAndCreated()
        && incoming().updatedAt == request.time
        && (
          isBootstrapAdmin() ||
          (existing().status == 'PENDING_APPROVAL' && incoming().status == 'PENDING_APPROVAL' && incoming().diff(existing()).affectedKeys().hasOnly(['supplierId', 'locationId', 'totalAmount', 'notes', 'items', 'expectedAt', 'updatedAt'])) ||
          (existing().status == 'PENDING_APPROVAL' && incoming().status == 'APPROVED' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'approvedBy', 'updatedAt'])) ||
          (existing().status == 'PENDING_APPROVAL' && incoming().status == 'APPROVED' && incoming().diff(existing()).affectedKeys().hasOnly(['supplierId', 'locationId', 'totalAmount', 'notes', 'items', 'expectedAt', 'status', 'approvedBy', 'updatedAt'])) ||
          (existing().status in ['PENDING_APPROVAL', 'APPROVED'] && incoming().status == 'CANCELLED' && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])) ||
          (existing().status in ['APPROVED', 'PARTIAL', 'PARTIALLY_RECEIVED'] && incoming().status in ['PARTIAL', 'PARTIALLY_RECEIVED', 'RECEIVED'] && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'items', 'updatedAt']))
        );
      allow delete: if isValidId(poId) && isDocOwner();
