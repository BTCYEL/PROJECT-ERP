        && preservesImmutableOwnerAndCreated()
        && incoming().updatedAt == request.time
        && (
          isBootstrapAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['email', 'fullName', 'roleId', 'roleCode', 'roleName', 'assignedLocationId', 'avatarUrl', 'passwordHash', 'isActive', 'updatedAt'])
        );
      allow delete: if isValidId(erpUserId) && isDocOwner();
    }

